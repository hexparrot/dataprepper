#!/usr/bin/env python3
"""
Chat log parser - processes organized chat directories and outputs structured JSON.

Expected input structure:
    userdata/raw/chat/{messenger}/{owner}/{participant}/files

Output naming:
    {messenger}-{owner}-{participant}-{original_filename}.json
"""
import re
import os
import sys
import json
import hashlib
import logging
from pathlib import Path
from datetime import datetime, timedelta
from dataclasses import dataclass, field, asdict
from typing import List, Optional

from xform.aimlogs_parser import AimLogsParser
from xform.aimlogs2_parser import AimLogs2Parser
from xform.aimlogs3_parser import AimLogs3Parser
from xform.fbchat_parser import FbchatParser
from xform.msn_parser import MsnParser
from xform.gvoice_parser import GvoiceParser
from xform.gchat_parser import GchatParser

logging.basicConfig(
    stream=sys.stderr,
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
)
logger = logging.getLogger(__name__)

BASE_DIR = Path(__file__).parent.resolve()
RAW_CHAT_DIR = BASE_DIR / "userdata" / "raw" / "chat"
TRANSFORMED_DIR = BASE_DIR / "userdata" / "transformed" / "chat"
REPORT_DIR = BASE_DIR / "userdata" / "reports"

VALID_EXTENSIONS = {".html", ".htm"}

# Parsers listed here are preferred when record counts are tied.
# Earlier entries beat later entries in a tie.
PREFERRED_PARSERS = [
    "AimLogs3Parser",
    "AimLogs2Parser",
    "AimLogsParser",
    "FbchatParser",
    "MsnParser",
    "GvoiceParser",
    "GchatParser",
]


@dataclass
class FileResult:
    """Track the processing result for a single file."""

    file_path: str
    messenger: str
    owner: str
    participant: str
    success: bool
    failure_reason: Optional[str] = None
    chosen_parser: Optional[str] = None
    record_count: int = 0
    date_corrections: int = 0
    parser_results: dict = field(default_factory=dict)


class ProcessingReport:
    """Collect and report on all file processing results."""

    def __init__(self):
        self.results: List[FileResult] = []
        self.start_time = datetime.now()
        self.end_time: Optional[datetime] = None

    def add_result(self, result: FileResult):
        self.results.append(result)

    def finalize(self):
        self.end_time = datetime.now()

    @property
    def total(self) -> int:
        return len(self.results)

    @property
    def successful(self) -> List[FileResult]:
        return [r for r in self.results if r.success]

    @property
    def failed(self) -> List[FileResult]:
        return [r for r in self.results if not r.success]

    def get_failures_by_reason(self) -> dict:
        """Group failures by their reason."""
        by_reason = {}
        for r in self.failed:
            reason = r.failure_reason or "Unknown"
            by_reason.setdefault(reason, []).append(r.file_path)
        return by_reason

    def print_summary(self):
        """Print a comprehensive summary to the logger."""
        logger.info("=" * 70)
        logger.info("PROCESSING SUMMARY")
        logger.info("=" * 70)
        logger.info(f"  Start time:  {self.start_time.isoformat()}")
        logger.info(f"  End time:    {self.end_time.isoformat()}")
        duration = (self.end_time - self.start_time).total_seconds()
        logger.info(f"  Duration:    {duration:.2f} seconds")
        logger.info("-" * 70)
        logger.info(f"  Total files attempted: {self.total}")
        logger.info(f"  Successful:            {len(self.successful)}")
        logger.info(f"  Failed:                {len(self.failed)}")
        if self.total > 0:
            success_rate = (len(self.successful) / self.total) * 100
            logger.info(f"  Success rate:          {success_rate:.1f}%")

        if self.failed:
            logger.info("-" * 70)
            logger.info("FAILURES BY REASON:")
            for reason, files in self.get_failures_by_reason().items():
                logger.info(f"  [{reason}] ({len(files)} files)")
                for f in files:
                    logger.info(f"    - {f}")

        logger.info("=" * 70)

    def write_report(self, report_path: Path):
        """Write a detailed JSON report to file."""
        report_data = {
            "start_time": self.start_time.isoformat(),
            "end_time": self.end_time.isoformat() if self.end_time else None,
            "summary": {
                "total_files": self.total,
                "successful": len(self.successful),
                "failed": len(self.failed),
            },
            "failures_by_reason": self.get_failures_by_reason(),
            "failed_files": [
                {
                    "file_path": r.file_path,
                    "messenger": r.messenger,
                    "owner": r.owner,
                    "participant": r.participant,
                    "failure_reason": r.failure_reason,
                    "parser_results": r.parser_results,
                }
                for r in self.failed
            ],
            "successful_files": [
                {
                    "file_path": r.file_path,
                    "messenger": r.messenger,
                    "owner": r.owner,
                    "participant": r.participant,
                    "chosen_parser": r.chosen_parser,
                    "record_count": r.record_count,
                }
                for r in self.successful
            ],
        }

        report_path.parent.mkdir(parents=True, exist_ok=True)
        with open(report_path, "w", encoding="utf-8") as f:
            json.dump(report_data, f, indent=2)
        logger.info(f"Detailed report written to: {report_path}")


def read_file_with_fallback(file_path):
    """Try multiple encodings; return content or raise."""
    encodings = [
        ("utf-8", "strict"),
        ("utf-8", "replace"),
        ("latin-1", "strict"),  # latin-1 accepts any byte
    ]
    for encoding, errors in encodings:
        try:
            content = file_path.read_text(encoding=encoding, errors=errors)
            if encoding != "utf-8" or errors != "strict":
                logger.warning(f"  Read using {encoding}/{errors}: {file_path.name}")
            return content
        except UnicodeDecodeError:
            continue
    raise ValueError(f"Could not decode {file_path} with any encoding")


def get_parsers():
    """Return all available chat parsers as (name, parser) tuples."""
    return [
        ("AimLogs3Parser", AimLogs3Parser(date_str="1970-01-01")),
        ("AimLogsParser", AimLogsParser()),
        ("AimLogs2Parser", AimLogs2Parser(date_str="1970-01-01")),
        ("FbchatParser", FbchatParser()),
        ("MsnParser", MsnParser()),
        ("GvoiceParser", GvoiceParser()),
        ("GchatParser", GchatParser()),
    ]


def run_all_parsers(file_content):
    """
    Run all parsers on file content.
    Returns dict of {parser_name: {"records": [...], "count": int, "error": str|None}}
    """
    results = {}
    for name, parser in get_parsers():
        try:
            records = parser.parse(file_content) or []
            results[name] = {"records": records, "count": len(records), "error": None}
        except Exception as e:
            logger.debug(f"    {name}: error - {e}")
            results[name] = {"records": [], "count": 0, "error": str(e)}
    return results


def select_best_parser(results, preferred=None):
    """
    Select the parser with the most records.
    Ties are broken by position in `preferred` (earlier = higher priority).
    Returns (name, records) or (None, []).
    """
    if not results:
        return None, []

    if preferred is None:
        preferred = PREFERRED_PARSERS

    def sort_key(name):
        count = results[name]["count"]
        try:
            rank = preferred.index(name)
        except ValueError:
            rank = len(preferred)  # unknown parsers sort last
        return (-count, rank)

    best_name = min(results, key=sort_key)
    best = results[best_name]

    if best["count"] == 0:
        return None, []

    return best_name, best["records"]


def log_parser_results(results, chosen_name, file_path):
    """Log the record count for each parser and which was selected."""
    logger.info(f"  Parser results for {file_path.name}:")
    for name, data in sorted(results.items(), key=lambda x: -x[1]["count"]):
        marker = " <-- SELECTED" if name == chosen_name else ""
        error_note = f" (error: {data['error']})" if data.get("error") else ""
        logger.info(f"    {name}: {data['count']} records{marker}{error_note}")


def build_output_filename(messenger, owner, participant, original_name):
    """Build output filename: {messenger}-{owner}-{participant}-{stem}.ndjson"""
    stem = Path(original_name).stem
    return f"{messenger}-{owner}-{participant}-{stem}.ndjson"


def normalize_record(msg):
    """Normalize a parsed message dict to the standard output format."""
    return {
        "author": msg.get("author", "Unknown"),
        "timestamp": msg.get("timestamp", "1970-01-01T00:00:00"),
        "message": msg.get("message", ""),
    }


def compute_chat_id(records):
    """Compute a stable SHA-256 hash of the chat records for deduplication."""
    sorted_records = sorted(
        records,
        key=lambda r: (
            r.get("timestamp", ""),
            r.get("author", ""),
            r.get("message", ""),
        ),
    )
    content_str = json.dumps(sorted_records, sort_keys=True, ensure_ascii=False)
    return hashlib.sha256(content_str.encode("utf-8")).hexdigest()


def extract_date_from_filename(filename):
    """
    Extract a date from a filename containing a YYYY-MM-DD pattern.
    Returns a datetime.date or None.
    """
    match = re.search(r"(\d{4})-(\d{2})-(\d{2})", filename)
    if match:
        try:
            return datetime(
                int(match.group(1)), int(match.group(2)), int(match.group(3))
            ).date()
        except ValueError as e:
            logger.warning(f"  Invalid date in filename '{filename}': {e}")
    return None


def is_epoch_date(timestamp_str):
    """Return True if the timestamp falls on the Unix epoch date (1970-01-01)."""
    return timestamp_str.startswith("1970-01-01")


def parse_timestamp(timestamp_str):
    """Parse an ISO timestamp string into a datetime object, or return None."""
    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S.%f"):
        try:
            return datetime.strptime(timestamp_str, fmt)
        except ValueError:
            continue
    return None


def correct_record_dates(records, filename_date, file_path):
    """
    Correct records with suspicious dates:
    - Epoch date (1970-01-01): replace with filename_date, preserve time.
    - Deviation > 2 days from filename_date: replace date, preserve time.

    Returns (corrected_records, correction_count).
    """
    if not filename_date:
        logger.debug(f"  No filename date available for correction: {file_path.name}")
        return records, 0

    corrected_records = []
    epoch_corrections = 0
    deviation_corrections = 0

    for record in records:
        timestamp_str = record.get("timestamp", "")
        corrected_record = record.copy()

        if is_epoch_date(timestamp_str):
            parsed = parse_timestamp(timestamp_str)
            if parsed:
                corrected_record["timestamp"] = datetime.combine(
                    filename_date, parsed.time()
                ).strftime("%Y-%m-%dT%H:%M:%S")
                epoch_corrections += 1
                logger.debug(
                    f"    Epoch date corrected: {timestamp_str} -> {corrected_record['timestamp']}"
                )
        else:
            parsed = parse_timestamp(timestamp_str)
            if parsed:
                deviation_days = abs((parsed.date() - filename_date).days)
                if deviation_days > 2:
                    corrected_record["timestamp"] = datetime.combine(
                        filename_date, parsed.time()
                    ).strftime("%Y-%m-%dT%H:%M:%S")
                    deviation_corrections += 1
                    logger.debug(
                        f"    Date deviation ({deviation_days} days) corrected: "
                        f"{timestamp_str} -> {corrected_record['timestamp']}"
                    )

        corrected_records.append(corrected_record)

    correction_count = epoch_corrections + deviation_corrections
    if correction_count > 0:
        logger.info(
            f"  Date corrections applied: {correction_count} total "
            f"(epoch: {epoch_corrections}, deviation: {deviation_corrections})"
        )

    return corrected_records, correction_count


def process_file(
    file_path, messenger, owner, participant, output_dir, seen_chat_ids
) -> FileResult:
    """Process a single chat file through all parsers and write output."""
    logger.info(f"Processing: {file_path}")

    result = FileResult(
        file_path=str(file_path),
        messenger=messenger,
        owner=owner,
        participant=participant,
        success=False,
    )

    try:
        content = read_file_with_fallback(file_path)
    except Exception as e:
        logger.error(f"  Failed to read file: {e}")
        result.failure_reason = f"Read error: {e}"
        return result

    parser_results = run_all_parsers(content)
    chosen_name, records = select_best_parser(parser_results)

    result.parser_results = {
        name: {"count": data["count"], "error": data.get("error")}
        for name, data in parser_results.items()
    }

    log_parser_results(parser_results, chosen_name, file_path)

    if not records:
        logger.warning(f"  No records extracted from {file_path.name}")
        result.failure_reason = "No records extracted by any parser"
        return result

    result.chosen_parser = chosen_name
    result.record_count = len(records)

    filename_date = extract_date_from_filename(file_path.name)
    if filename_date:
        logger.debug(f"  Filename date extracted: {filename_date}")
    else:
        logger.warning(f"  Could not extract date from filename: {file_path.name}")

    normalized = [normalize_record(msg) for msg in records]
    corrected, correction_count = correct_record_dates(
        normalized, filename_date, file_path
    )

    if correction_count > 0:
        result.parser_results["date_corrections"] = correction_count

    chat_id = compute_chat_id(corrected)
    if chat_id in seen_chat_ids:
        logger.info(f"  Skipping duplicate content (chat_id: {chat_id[:12]}...)")
        result.failure_reason = "Duplicate content (matching chat_id)"
        return result

    seen_chat_ids.add(chat_id)

    output_path = output_dir / build_output_filename(
        messenger, owner, participant, file_path.name
    )

    try:
        with open(output_path, "w", encoding="utf-8") as f:
            for record in corrected:
                json.dump(record, f)
                f.write("\n")
        logger.info(f"  Saved {len(corrected)} records to {output_path.name}")
        result.success = True
    except Exception as e:
        logger.error(f"  Failed to write output: {e}")
        result.failure_reason = f"Write error: {e}"

    return result


def walk_chat_directory(base_dir):
    """
    Yield (file_path, messenger, owner, participant) for each valid chat file.

    Expected structure: base_dir/{messenger}/{owner}/{participant}/[subfolders/]files
    """
    for messenger_dir in sorted(base_dir.iterdir()):
        if not messenger_dir.is_dir():
            continue
        for owner_dir in sorted(messenger_dir.iterdir()):
            if not owner_dir.is_dir():
                continue
            for participant_dir in sorted(owner_dir.iterdir()):
                if not participant_dir.is_dir():
                    continue
                for file_path in sorted(participant_dir.rglob("*")):
                    if (
                        file_path.is_file()
                        and file_path.suffix.lower() in VALID_EXTENSIONS
                    ):
                        yield file_path, messenger_dir.name, owner_dir.name, participant_dir.name


def main():
    logger.info("=" * 70)
    logger.info("Chat Log Parser - Starting")
    logger.info("=" * 70)

    if not RAW_CHAT_DIR.exists():
        logger.error(f"Input directory does not exist: {RAW_CHAT_DIR}")
        sys.exit(1)

    TRANSFORMED_DIR.mkdir(parents=True, exist_ok=True)

    report = ProcessingReport()
    seen_chat_ids = set()

    for file_path, messenger, owner, participant in walk_chat_directory(RAW_CHAT_DIR):
        report.add_result(
            process_file(
                file_path, messenger, owner, participant, TRANSFORMED_DIR, seen_chat_ids
            )
        )

    report.finalize()
    report.print_summary()

    timestamp = report.start_time.strftime("%Y%m%d_%H%M%S")
    report.write_report(REPORT_DIR / f"parse_report_{timestamp}.json")

    if report.failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
